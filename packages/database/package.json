{
  "name": "@comunidad/database",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "prisma generate --config=prisma.generate.config.ts",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.build.json",
    "backend:env": "node scripts/configurar-backend.ts",
    "seed": "prisma db seed --config=prisma.migrate.config.ts",
    "seed:test": "node prisma/seed.ts --database comunidad_deportiva_baseline_test",
    "test:seed": "node --test prisma/seed.integration.test.ts",
    "db:permissions": "node scripts/permisos.ts --database comunidad_deportiva_dev",
    "db:permissions:test": "node scripts/permisos.ts --database comunidad_deportiva_baseline_test",
    "test:permissions": "node --test scripts/permisos.integration.test.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
