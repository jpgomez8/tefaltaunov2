  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                  String                    @unique(map: "actividades_codigo_unique") @db.VarChar(50)
  nombre                  String                    @db.VarChar(100)
  descripcion             String?
  activo                  Boolean                   @default(true)
  creado_en               DateTime                  @default(now()) @db.Timestamptz(6)
  actualizado_en          DateTime                  @default(now()) @db.Timestamptz(6)
  encuentros              encuentros[]
  intenciones             intenciones[]
  preferencias_deportivas preferencias_deportivas[]
